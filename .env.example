# Create a NEW key at https://openrouter.ai/keys.
# Never paste a real key into index.html or commit it to Git.
OPENROUTER_API_KEY=replace_with_your_new_key

# Optional. The dynamic free-model router is used by default.
OPENROUTER_MODEL=openrouter/free

# Optional attribution URL sent to OpenRouter.
PUBLIC_APP_URL=https://nevio.vercel.app
